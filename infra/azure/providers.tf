terraform {
  required_version = ">= 1.5"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.14"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Authentification : `az login` avant `terraform apply`.
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
